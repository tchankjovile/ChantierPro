{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=chantierpro.db"
  },
  "Jwt": {
    "Issuer": "ChantierPro",
    "Audience": "ChantierPro.Mobile",
    "Key": "CHANGE-ME-dev-only-signing-key-at-least-32-characters-long",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimit": {
    "LoginPerMinute": 20
  },
  "Storage": {
    "UploadsPath": "uploads",
    "MaxUploadBytes": 10485760
  },
  "App": {
    "TimeZone": "Africa/Douala"
  },
  "Seed": {
    "AdminName": "Administrateur",
    "AdminEmail": "",
    "AdminPassword": "",
    "DemoData": false,
    "DemoPassword": ""
  }
}
