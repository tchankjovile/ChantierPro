<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- La version cible s'adapte automatiquement dans Directory.Build.props (propriete ChantierProDotNet). -->
    <!-- Sur Windows, la cible Windows est placee en premier pour etre selectionnee par defaut dans Visual Studio. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net$(ChantierProDotNet)-windows10.0.19041.0;net$(ChantierProDotNet)-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">net$(ChantierProDotNet)-android</TargetFrameworks>
    <!-- iOS : uniquement sur macOS (sous Windows, la cible iOS fait echouer la restauration/compilation). -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net$(ChantierProDotNet)-ios</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>ChantierPro.Mobile</RootNamespace>
    <AssemblyName>ChantierPro.App</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>ChantierPro</ApplicationTitle>
    <ApplicationId>com.chantierpro.app</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Exigences du cahier des charges : Android 8.0+ et iOS 15+ -->
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Permet de lancer l'application sur Windows sans certificat MSIX ni Mode Developpeur Windows -->
    <WindowsPackageType Condition="$(TargetFramework.Contains('-windows'))">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="$(TargetFramework.Contains('-windows'))">true</WindowsAppSDKSelfContained>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icone et ecran de demarrage -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1F3A5F" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F3A5F" BaseSize="128,128" />

    <!-- Polices et images -->
    <MauiFont Include="Resources\Fonts\*" />
    <MauiImage Include="Resources\Images\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChantierPro.Core\ChantierPro.Core.csproj" />
  </ItemGroup>

</Project>
