<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:ChantierPro.Mobile.Converters"
             x:Class="ChantierPro.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Convertisseurs globaux -->
            <converters:MoneyFormatConverter x:Key="MoneyFormatConverter" />
            <converters:CompactMoneyConverter x:Key="CompactMoneyConverter" />
            <converters:PercentFormatConverter x:Key="PercentFormatConverter" />
            <converters:DateFormatConverter x:Key="DateFormatConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <converters:ToneToColorConverter x:Key="ToneToColorConverter" />
            <converters:ToneToBgConverter x:Key="ToneToBgConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
