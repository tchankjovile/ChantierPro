<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ChantierPro.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ChantierPro.Mobile.Views"
    xmlns:helpers="clr-namespace:ChantierPro.Mobile.Helpers"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarTitleColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}">

    <!-- Écran de connexion (hors onglets) -->
    <ShellContent
        Route="login"
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Navigation principale par onglets (5 entrées selon Cahier des charges §11) -->
    <TabBar Route="main">
        <!-- 1. Accueil / Synthèse -->
        <Tab Title="Accueil" Icon="logo_light.svg" Route="dashboard">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>

        <!-- 2. Chantiers -->
        <Tab Title="Chantiers" Icon="logo_light.svg" Route="chantiers">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>

        <!-- 3. Pointage -->
        <Tab Title="Pointage" Icon="logo_light.svg" Route="attendance">
            <ShellContent ContentTemplate="{DataTemplate views:AttendancePage}" />
        </Tab>

        <!-- 4. Stock -->
        <Tab Title="Stock" Icon="logo_light.svg" Route="stock">
            <ShellContent ContentTemplate="{DataTemplate views:StockPage}" />
        </Tab>

        <!-- 5. Plus / Menu -->
        <Tab Title="Paramètres" Icon="logo_light.svg" Route="settings">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>
