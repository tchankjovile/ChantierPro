<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChantierPro.Mobile.ViewModels"
             xmlns:models="clr-namespace:ChantierPro.Core.Models;assembly=ChantierPro.Core"
             xmlns:helpers="clr-namespace:ChantierPro.Mobile.Helpers"
             x:Class="ChantierPro.Mobile.Views.WorkersPage"
             x:DataType="vm:WorkersViewModel">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

        <!-- En-tête -->
        <Border Grid.Row="0" BackgroundColor="{StaticResource Primary}" StrokeThickness="0" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Style="{StaticResource IconButton}" Text="{x:Static helpers:Icons.ArrowBack}" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="Annuaire des ouvriers" Style="{StaticResource OnPrimaryTitle}" FontSize="18" VerticalOptions="Center" Margin="8,0" />
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Text="+ Ajouter" TextColor="{StaticResource Accent}" FontFamily="InterSemiBold" Command="{Binding AddWorkerCommand}" />
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="1" Spacing="12" Padding="16,14,16,20">

            <!-- Barre de recherche -->
            <Border Style="{StaticResource InputBorder}">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Style="{StaticResource IconGlyph}" Text="{x:Static helpers:Icons.Search}" FontSize="20" Margin="4,0,8,0" />
                    <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="Rechercher par nom ou métier..." ClearButtonVisibility="WhileEditing" />
                </Grid>
            </Border>

            <!-- Liste des ouvriers -->
            <CollectionView ItemsSource="{Binding Workers}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Worker">
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="0"
                                        BackgroundColor="#1F3A5F14" VerticalOptions="Center">
                                    <Label Style="{StaticResource IconGlyph}" Text="{x:Static helpers:Icons.Person}" TextColor="{StaticResource Primary}" FontSize="24" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" Style="{StaticResource Heading}" FontSize="16" />
                                    <Label Text="{Binding Trade}" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding DailyRate, Converter={StaticResource MoneyFormatConverter}, StringFormat='Taux : {0} / jour'}"
                                           Style="{StaticResource Caption}" FontFamily="InterMedium" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>

                                <Button Grid.Column="2"
                                        Style="{StaticResource IconButton}"
                                        Text="{x:Static helpers:Icons.Call}"
                                        TextColor="{StaticResource Success}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkersViewModel}}, Path=CallWorkerCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </Grid>
</ContentPage>
